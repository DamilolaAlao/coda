---
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import { HOSTED_APP_OPEN_URL, HOSTED_APP_URL } from "../lib/site";
---

<Layout pageClass="landing-page">
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="wordmark">coda</p>
        <h1>Agents, git, and apps - one private stack, in your browser or on your desktop.</h1>
        <div class="hero-actions">
          <a class="pill pill-light" href={HOSTED_APP_OPEN_URL}>Open web app <span aria-hidden="true">↗</span></a>
          <a class="pill pill-ghost" href="/download">Download desktop</a>
        </div>

        <div class="providers" aria-label="Supported agents">
          <span>Works with</span>
          <img src="/harnesses/claude-ai-icon.svg" alt="Claude Code" />
          <img src="/harnesses/openai_dark.svg" alt="Codex" />
          <img src="/harnesses/cursor_light.svg" alt="Cursor" />
          <img src="/harnesses/grok-dark.svg" alt="Grok" />
          <img src="/harnesses/opencode-dark.svg" alt="OpenCode" />
        </div>
      </div>

      <div class="preview" aria-hidden="true">
        <div class="preview-chrome">
          <span></span><span></span><span></span>
          <em>coda · typescript-rest-api</em>
        </div>
        <div class="preview-tabs">
          <span class="is-active">New chat</span>
          <span>Clone repo</span>
          <span>Review PR</span>
          <span>Apps</span>
        </div>
        <div class="preview-note">
          <div class="preview-note-head">
            <div>
              <div class="preview-kicker">Workspace</div>
              <strong>Clone the API, then start the server.</strong>
            </div>
            <span class="preview-status">Running</span>
          </div>
          <p>Search GitHub, clone over HTTPS, then keep the thread on the same project.</p>
          <p>Artifacts stay attached. Remote clients see the same environment.</p>
          <div class="preview-files">
            <code>apps/server/src/ws.ts</code>
            <code>packages/contracts/src/rpc.ts</code>
          </div>
        </div>
        <div class="preview-composer">
          <span>Message Coda…</span>
          <span class="preview-send"></span>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="sec">
    <div class="container">
      <div class="eyebrow">Features</div>
      <h2>Everything you need to think, ship, and share.</h2>
      <div class="feature-grid">
        <article>
          <span class="feature-mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
          </span>
          <h3>Synced threads</h3>
          <p>Keep agent history with the project, then pick it up from the browser, desktop, or phone.</p>
        </article>
        <article>
          <span class="feature-mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M8 8l4-4 4 4M8 16l4 4 4-4"/></svg>
          </span>
          <h3>Bring your own agent</h3>
          <p>Orchestrate Claude Code, Codex, Cursor, Grok, Hermes, and OpenCode with the plans you already pay for.</p>
        </article>
        <article>
          <span class="feature-mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.2"/><circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M6 8v8M18 8v5a3 3 0 01-3 3h-3"/></svg>
          </span>
          <h3>GitHub clone and push</h3>
          <p>Search your repos, clone over HTTPS, then commit and open a pull request from the same surface.</p>
        </article>
        <article>
          <span class="feature-mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 20h8"/></svg>
          </span>
          <h3>Background apps</h3>
          <p>Launch, inspect, and stop the servers your agent starts without leaving the thread.</p>
        </article>
        <article>
          <span class="feature-mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
          <h3>Remote ready</h3>
          <p>Pair from the local network, Tailscale, or a hosted environment. The websocket layer is the product.</p>
        </article>
        <article>
          <span class="feature-mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="5" r="2.2"/><circle cx="18" cy="5" r="2.2"/><circle cx="12" cy="19" r="2.2"/><path d="M6 7.2v2A3 3 0 009 12.2h6A3 3 0 0018 9.2v-2M12 14v2.8"/></svg>
          </span>
          <h3>Open source</h3>
          <p>Fork the whole stack. Coda stays a bring-your-own-subscription control plane, not a token reseller.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="platforms" class="sec">
    <div class="container">
      <div class="eyebrow">Platforms</div>
      <h2>Web app and native desktops. Remote included.</h2>
      <p class="sec-sub">
        Start in the browser, install the desktop shell when you want a dedicated window, or pair
        mobile to the same environment.
      </p>
      <div class="platform-list">
        <a href={HOSTED_APP_URL}>
          <div>
            <b>Web app</b>
            <span>Chat, git, and apps — in the browser</span>
          </div>
          <em>Open web app</em>
        </a>
        <a href="/download">
          <div>
            <b>macOS</b>
            <span>Native desktop for Apple Silicon and Intel</span>
          </div>
          <em>Download for Mac</em>
        </a>
        <a href="/download">
          <div>
            <b>Windows</b>
            <span>Installer build from GitHub Releases</span>
          </div>
          <em>Download for Windows</em>
        </a>
        <a href="/download">
          <div>
            <b>Linux</b>
            <span>AppImage for modern Linux desktops</span>
          </div>
          <em>Download for Linux</em>
        </a>
        <a href="/download">
          <div>
            <b>Mobile</b>
            <span>Control the same environment from iOS or Android</span>
          </div>
          <em>See downloads</em>
        </a>
      </div>
    </div>
  </section>

  <section id="how" class="sec">
    <div class="container">
      <div class="eyebrow">How it works</div>
      <h2>One pairing. Work from any surface.</h2>
      <div class="steps">
        <article>
          <span class="step-num">01</span>
          <h3>Pair</h3>
          <p>Open the web app, desktop shell, or mobile client and pair it to your Coda server with a one-time token.</p>
        </article>
        <article>
          <span class="step-num">02</span>
          <h3>Open a project</h3>
          <p>Clone a repo over HTTPS or start fresh. The thread belongs to the project, not to one machine.</p>
        </article>
        <article>
          <span class="step-num">03</span>
          <h3>Run and resume</h3>
          <p>Direct any agent you subscribe to, then pick the work back up on another device. Checkpoints keep every state restorable.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="sec trust">
    <div class="container">
      <div class="trust-grid">
        <div>
          <div class="eyebrow">Your data</div>
          <h2>Bring your own subscriptions.</h2>
          <p class="sec-sub">Coda is your control plane, not a reseller. Credentials, state, and traffic stay yours.</p>
        </div>
        <ul class="trust-list">
          <li>
            <b>Your models</b>
            <span>Use the provider plans you already pay for - Claude Code, Codex, Cursor, Grok, Hermes, OpenCode.</span>
          </li>
          <li>
            <b>Your state</b>
            <span>The server runs on your machine or wherever you host it. Threads, artifacts, and apps stay in your environment.</span>
          </li>
          <li>
            <b>Your network</b>
            <span>Pair over local network, Tailscale, or the Coda Connect tunnel. Nothing routes through a third-party cloud.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="sec stats-sec">
    <div class="container">
      <div class="stats">
        <div><b>100k+</b><span>people driving agents with Coda</span></div>
        <div><b>6</b><span>agents you can bring</span></div>
        <div><b>3</b><span>surfaces, one environment</span></div>
        <div><b>100%</b><span>open source, MIT licensed</span></div>
      </div>
    </div>
  </section>

  <section id="opensource" class="sec open">
    <div class="container">
      <div class="open-inner">
        <div class="eyebrow">Open source</div>
        <h2>Coda is open at the core.</h2>
        <p class="sec-sub">The server, contracts, web, desktop, and mobile clients live in one MIT-licensed repo. Fork the stack, follow the roadmap, and ship with us.</p>
        <div class="hero-actions">
          <a class="pill pill-light" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">Star on GitHub</a>
          <a class="pill pill-ghost" href="https://discord.gg/v7bZhVjuE" target="_blank" rel="noopener noreferrer">Join the Discord</a>
        </div>
      </div>
    </div>
  </section>

  <section id="download" class="sec close">
    <div class="close-glow" aria-hidden="true"></div>
    <div class="container close-inner">
      <div class="eyebrow">Get started</div>
      <h2>Open the web app, or install where you work.</h2>
      <div class="hero-actions">
        <a class="pill pill-light" href={HOSTED_APP_OPEN_URL}>Open web app</a>
        <a class="pill pill-ghost" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">GitHub Releases</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 56px 0 40px;
    border-top: 0;
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  }

  .close-glow {
    position: absolute;
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 75% 60% at 50% 18%, black 18%, transparent 78%);
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    align-items: center;
    gap: 48px;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-copy > *,
  .preview {
    animation: hero-in 650ms var(--ease-out) backwards;
  }

  .hero-copy > :nth-child(1) {
    animation-delay: 0ms;
  }

  .hero-copy > :nth-child(2) {
    animation-delay: 80ms;
  }

  .hero-copy > :nth-child(3) {
    animation-delay: 160ms;
  }

  .hero-copy > :nth-child(4) {
    animation-delay: 240ms;
  }

  .preview {
    animation-delay: 320ms;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .wordmark {
    margin: 0;
    font-size: clamp(80px, 17vw, 176px);
    font-weight: 800;
    letter-spacing: -0.074em;
    line-height: 0.84;
    color: var(--fg);
  }

  h1 {
    max-width: 18ch;
    margin: 28px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(34px, 5vw, 56px);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .sec-sub {
    max-width: 34rem;
    margin: 28px 0 0;
    color: var(--fg-muted);
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    border: 1px solid transparent;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .pill-light {
    background: #e7eef2;
    color: #081018;
  }

  .pill-light:hover {
    background: #fff;
  }

  .pill:active {
    transform: scale(0.97);
  }

  .pill-ghost {
    border-color: rgba(232, 238, 242, 0.22);
  }

  .pill-ghost:hover {
    border-color: rgba(232, 238, 242, 0.4);
    background: rgba(255, 255, 255, 0.04);
  }

  .providers {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
    color: var(--fg-dim);
    font-size: 13px;
    font-weight: 500;
  }

  .providers img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    opacity: 0.78;
  }

  .preview {
    width: 100%;
    padding: 10px 10px 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.015)),
      rgba(10, 20, 28, 0.88);
    box-shadow:
      0 40px 90px -36px rgba(0, 0, 0, 0.85),
      0 0 0 1px rgba(134, 212, 200, 0.06);
  }

  .preview-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px 12px;
    color: var(--fg-dim);
    font-size: 12px;
  }

  .preview-chrome span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
  }

  .preview-chrome em {
    margin-left: 8px;
    font-style: normal;
    letter-spacing: -0.01em;
  }

  .preview-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 0 8px 14px;
    color: var(--fg-dim);
    font-size: 13px;
    font-weight: 600;
  }

  .preview-tabs span {
    flex: none;
    padding: 8px 12px;
    border-radius: 999px;
  }

  .preview-tabs .is-active {
    background: rgba(255, 255, 255, 0.07);
    color: var(--fg);
  }

  .preview-note {
    margin: 0 8px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.025);
  }

  .preview-note-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .preview-kicker {
    color: var(--fg-dim);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .preview-note strong {
    display: block;
    margin-top: 6px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .preview-status {
    flex: none;
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid rgba(134, 212, 200, 0.35);
    color: var(--accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .preview-note p {
    margin: 10px 0 0;
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .preview-files {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .preview-files code {
    padding: 6px 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .preview-composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 50px;
    margin: 12px 8px 0;
    padding: 0 8px 0 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-dim);
    font-size: 14px;
    background: rgba(0, 0, 0, 0.18);
  }

  .preview-send {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background:
      radial-gradient(circle at 50% 45%, #9be0d5, var(--accent));
  }

  .sec {
    padding: 88px 0 28px;
    border-top: 0;
  }

  .eyebrow {
    color: var(--fg-dim);
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }

  .sec h2 {
    max-width: 16ch;
    margin: 10px 0 0;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 36px;
  }

  .feature-grid article {
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .feature-grid article:hover {
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.035);
  }

  .feature-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-bottom: 14px;
    border-radius: 10px;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .feature-grid h3 {
    margin: 0;
    font-size: 17px;
  }

  .feature-grid p {
    margin: 8px 0 0;
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .platform-list {
    display: grid;
    gap: 10px;
    margin-top: 32px;
  }

  .platform-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .platform-list a:hover {
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.04);
  }

  .platform-list a:hover em {
    color: var(--fg);
  }

  .platform-list b {
    display: block;
  }

  .platform-list span,
  .platform-list em {
    color: var(--fg-muted);
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 36px;
  }

  .steps article {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .steps article:hover {
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.035);
  }

  .step-num {
    color: var(--accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .steps h3 {
    margin: 14px 0 0;
    font-size: 17px;
  }

  .steps p {
    margin: 8px 0 0;
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 48px;
    align-items: start;
  }

  .trust-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-list li {
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.02);
  }

  .trust-list b {
    display: block;
    font-size: 15px;
  }

  .trust-list span {
    display: block;
    margin-top: 6px;
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 40px;
  }

  .stats > div {
    padding: 28px 24px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
  }

  .stats b {
    display: block;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .stats span {
    display: block;
    margin-top: 10px;
    color: var(--fg-muted);
    font-size: 13px;
  }

  .open {
    padding: 96px 0 28px;
  }

  .open-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .open-inner h2 {
    margin-left: auto;
    margin-right: auto;
  }

  .open-inner .sec-sub {
    max-width: 44rem;
    margin-left: auto;
    margin-right: auto;
  }

  .close {
    position: relative;
    overflow: hidden;
    padding: 96px 0 104px;
  }

  .close-glow {
    inset: auto 0 -40% 0;
    height: 70%;
    background: radial-gradient(ellipse at center, rgba(134, 212, 200, 0.14), transparent 68%);
  }

  .close-inner {
    position: relative;
  }

